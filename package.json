{
  "name": "swiftie-api-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A free, open-source, fan-made API for Taylor Swift discography, eras, quotes, and metadata.",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -F @swiftie-api/data build && pnpm -F @swiftie-api/data -F @swiftie-api/server -F @swiftie-api/server-frontend --parallel dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "validate:data": "tsx packages/data/scripts/validate-data.ts",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@changesets/cli": "^2.27.0",
    "@types/node": "^24.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0",
    "zod": "^4.4.3"
  }
}
