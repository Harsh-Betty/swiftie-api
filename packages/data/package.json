{
  "name": "@swiftie-api/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Internal source-of-truth data package for swiftie-api: Zod schemas, JSON data, and loaders for albums, songs, lyrics, quotes, and eras.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsdown": "^0.22.0"
  }
}
