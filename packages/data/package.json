{
  "name": "@swiftie-api/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Internal source-of-truth data package for swiftie-api: Zod schemas, JSON data, and loaders for albums, songs, lyrics, quotes, and eras.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsdown": "^0.21.10"
  }
}
